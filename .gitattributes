# Windows 批处理必须是 CRLF（LF 会被 Windows 命令解释器误读）
*.bat text eol=crlf
*.cmd text eol=crlf

# 源码统一 LF
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.spec text eol=lf

# 二进制
*.png binary
*.jpg binary
*.exe binary
